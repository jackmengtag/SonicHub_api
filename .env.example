HTTP_ADDR=:8080
DATABASE_URL=postgres://sonichub:sonichub@localhost:5432/sonichub?sslmode=disable
JWT_SECRET=sonichub-dev-secret-change-me
DEMO_AUTH_CODE=1234
# 允许使用演示验证码登录（仅本地调试，生产必须为 false）
ALLOW_DEMO_CODE=false
SEED_DEMO=true
ADMIN_PHONE=13800138000
MEDIA_DIR=./data/media
MIGRATIONS_DIR=./migrations
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30

# 阿里云号码认证服务（Dypnsapi）短信验证码；不配置时回退到 DEMO_AUTH_CODE 演示验证码
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_SCENE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
# 短信通道：dypns=号码认证服务（Android SDK 流程）；dysms=短信服务 + 服务端自建验证码
SMS_PROVIDER=dypns

# 腾讯云对象存储（COS）：生成完成的音频上传到桶中，audio_url 返回 COS 链接；留空则回退本地 /media
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 可选：自定义访问域名或 CDN 域名，留空则使用 https://<bucket>.cos.<region>.myqcloud.com
COS_PUBLIC_BASE=
# 对象 ACL：public-read（默认，可直接播放）；default 表示沿用桶的默认权限
COS_ACL=public-read

# 远程音乐大模型：同步 POST JSON，响应中返回音频 URL（audio_url / data.audio_url / url 均可）
# 留空则使用内置 WAV 合成器
MUSIC_MODEL_URL=
MUSIC_MODEL_API_KEY=
MUSIC_MODEL_TIMEOUT_SECONDS=150
